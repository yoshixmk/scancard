{
  "name": "scancard-appium",
  "version": "1.0.0",
  "private": true,
  "description": "Appium E2E tests for ScanCard",
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:home": "wdio run wdio.conf.js --spec specs/home.e2e.js",
    "test:scan-export": "wdio run wdio.conf.js --spec specs/scanToExport.e2e.js",
    "test:filter": "wdio run wdio.conf.js --spec specs/studyFilter.e2e.js",
    "test:validation": "wdio run wdio.conf.js --spec specs/deckValidation.e2e.js",
    "test:slow": "wdio run wdio.slow.conf.js",
    "test:fast-flow": "wdio run wdio.slow.conf.js --spec specs/fastFlow.e2e.js",
    "appium": "appium",
    "lint": "node --check wdio.conf.js && node --check helpers/caps.js && echo \"lint ok\"",
    "postinstall": "node scripts/patch-p-limit.js"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.18.0",
    "@wdio/cli": "^9.18.0",
    "@wdio/local-runner": "^9.18.0",
    "@wdio/mocha-framework": "^9.18.0",
    "@wdio/spec-reporter": "^9.18.0",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.5.0"
  },
  "overrides": {
    "p-limit": "3.1.0"
  },
  "dependencies": {
    "p-limit": "3.1.0"
  }
}
