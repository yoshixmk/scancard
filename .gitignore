# Project specific ignores
# AI Pack model binaries are large: keep them out of git, place locally before bundleRelease
# Gemma 4 E2B (2.6GB) is split into 2 packs to stay under Play 1.5GB/pack limit
gemma-ai-pack/src/main/assets/*.litertlm
gemma-ai-pack/src/main/assets/*.part0
gemma-ai-pack/src/main/assets/*.part1
gemma-ai-pack-2/src/main/assets/*.litertlm
gemma-ai-pack-2/src/main/assets/*.part0
gemma-ai-pack-2/src/main/assets/*.part1
improvement.md
all_kt_files.txt
deps.txt
app/release/
